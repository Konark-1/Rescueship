# ============================================
# RescueShip — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================

# --- Server ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/rescueship

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Auth (Dashboard) ---
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d

# --- Encryption Key (AES-256 for merchant API keys) ---
ENCRYPTION_KEY=your-32-char-encryption-key-here

# --- Meta WhatsApp Cloud API ---
# These are DEFAULT values. Each merchant can override with their own.
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret-for-webhook-signature

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Cashfree ---
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_API_VERSION=2023-08-01

# --- Shiprocket ---
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password

# --- Shopify (for app-level auth, not per-merchant) ---
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret

# --- Assisted onboarding & operator notifications ---
# Public scheduling link (Calendly/Cal.com…) shown to merchants after purchase
SETUP_CALL_URL=
# Your inbox — receives signup / plan-purchase / setup-request notifications
OWNER_NOTIFY_EMAIL=

# --- Logging ---
LOG_LEVEL=debug
