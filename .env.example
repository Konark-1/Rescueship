# ============================================
# RescueShip — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================

# --- Server ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
# Public URL Shopify redirects back to and webhooks post to (tunnel/domain, NOT localhost)
API_PUBLIC_URL=

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/rescueship

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Auth (Dashboard) ---
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=7d

# --- Encryption Key (AES-256 for merchant API keys) ---
ENCRYPTION_KEY=your-32-char-encryption-key-here

# --- Meta WhatsApp Cloud API ---
# These are DEFAULT values. Each merchant can override with their own.
WHATSAPP_API_VERSION=v22.0
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret-for-webhook-signature

# --- Razorpay ---
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- Cashfree ---
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_API_VERSION=2023-08-01

# --- Shopify (for app-level auth, not per-merchant) ---
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret

# --- Assisted onboarding & operator notifications ---
# Public scheduling link (Calendly/Cal.com…) shown to merchants after purchase
SETUP_CALL_URL=
# Your inbox — receives signup / plan-purchase / setup-request notifications
OWNER_NOTIFY_EMAIL=

# --- KIE AI (GPT-6 Astra) ---
KIE_AI_API_URL=https://api.kie.ai/codex/v1/responses
KIE_AI_API_KEY=your-kie-ai-api-key
KIE_AI_MODEL=gpt-6-astra

# --- Gemini (Google AI) ---
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Logging ---
LOG_LEVEL=debug

# --- Security / deployment ---
# Public https URL of this API (webhook callbacks, per-merchant carrier webhook URLs). Required in production.
API_PUBLIC_URL=
# Comma-separated CIDRs of your reverse proxy / load balancer (used for trust proxy + rate-limit IPs)
TRUSTED_PROXIES=
# Merchant IDs allowed to read platform-wide cohort metrics (/api/metrics/cohort)
ADMIN_MERCHANT_IDS=
# Platform-wide legacy carrier webhook secrets (per-merchant secrets issued on carrier connect are preferred)
SHIPROCKET_WEBHOOK_SECRET=
CLICKPOST_WEBHOOK_SECRET=
DELHIVERY_WEBHOOK_SECRET=
# Local development ONLY. Startup fails in production if either is 'true'.
ENABLE_DEMO_MODE=false
EMAIL_DEBUG_LOG_BODY=false

# --- Added Oct 2026 (red-team fixes) ---
# Ops: X-Ops-Key for /api/liveops details + alert trigger; recipient for ops/DLQ alerts
OPS_API_KEY=
OPS_ALERT_EMAIL=
# Security alert webhook (Slack/Discord) and per-event throttle
SECURITY_ALERT_WEBHOOK=
SECURITY_ALERT_THROTTLE_MS=60000
# Frontend base URL used in verification / reset emails
APP_URL=
# Meta: one app for Embedded Signup + webhooks (WHATSAPP_APP_SECRET or META_APP_SECRET)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# Only for a redirect-based OAuth flow; the JS SDK popup flow sends no redirect_uri
META_REDIRECT_URI=
# Google sign-in (required; without it /api/auth/google returns 503)
GOOGLE_CLIENT_ID=
# Shopify Admin API version used everywhere
SHOPIFY_API_VERSION=2026-07
# Gateway / courier environments (explicit; NODE_ENV is only the fallback)
CASHFREE_ENV=sandbox
DELHIVERY_ENV=staging
# Carriers whose COD amount can be changed AFTER dispatch via a verified API (empty = none)
COD_AMENDABLE_CARRIERS=
# ClickPost NDR action endpoint (v2)
CLICKPOST_NDR_URL=https://www.clickpost.in/api/v2/ndr-update-api
# Development only — never set in production
CARRIER_SIMULATE=
ALLOW_DEV_TUNNEL_ORIGINS=
WHATSAPP_ALLOW_UNSIGNED_WEBHOOKS=
# Tests only (tests/setup-env.ts sets these): skip .env loading / payment-webhook gate
SKIP_DOTENV=
PAYMENT_REQUIRE_VERIFIED_WEBHOOK=

# Free test rescues (unpaid merchants message their OWN verified phone from their OWN WhatsApp number)
# FREE_TEST_ENABLED=true            # set false to switch free tests off
# FREE_TEST_LIFETIME_LIMIT=3        # per WhatsApp number / WABA / owner phone / store
# FREE_TEST_DAILY_PER_MERCHANT=5
# FREE_TEST_GLOBAL_DAILY_CAP=300    # across the whole platform, per IST day
# TEST_SEND_DAILY_PER_PAID_MERCHANT=20
