{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless"
      ]
    },
    "magicui": {
      "command": "npx",
      "args": [
        "-y",
        "magicui-mcp@latest"
      ]
    },
    "twenty-first": {
      "serverUrl": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "YOUR_21ST_API_KEY"
      }
    }
  }
}
