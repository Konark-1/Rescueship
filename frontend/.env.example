# ============================================
# RescueShip Frontend — Environment Variables
# ============================================
# Copy to .env and fill in. All VITE_* vars are
# baked into the bundle at build time (public).

# --- Google OAuth (public client ID is safe to expose) ---
VITE_GOOGLE_CLIENT_ID=

# --- API base URL ---
# Leave EMPTY for the normal setup:
#   dev  → Vite dev server proxies /api to localhost:3000
#   prod → nginx proxies /api to the backend container
# Only set this if the API is hosted on a DIFFERENT origin.
VITE_API_URL=

# --- Meta WhatsApp Embedded Signup (required for onboarding) ---
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
